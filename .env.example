# Copy to .env.local and fill in from the Nexconn Console (Key Management).
# The App Key is public; the App Secret stays on the server and is never sent to the browser.
VITE_NEXCONN_APP_KEY=your-app-key
NEXCONN_APP_SECRET=your-app-secret

# On Vercel only: added automatically when you connect an Upstash Redis database.
# Locally, accounts are saved in data/db.json instead.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Encrypts everything the server stores (AES-256-GCM). Make one with: openssl rand -base64 32
# Keep it safe and never change it once set: data saved with it can't be read without it.
DATA_KEY=

# A secret that unlocks user management on /admin. On the live site, /admin management stays locked without it.
ADMIN_KEY=

# Push notifications (npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
